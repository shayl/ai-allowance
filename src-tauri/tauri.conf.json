{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Allowance",
  "version": "0.2.0",
  "identifier": "com.shayl.ai-allowance",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AI Allowance",
        "width": 860,
        "height": 960,
        "minWidth": 720,
        "minHeight": 760,
        "resizable": true,
        "center": true
      },
      {
        "label": "widget",
        "title": "AI Allowance Widget",
        "url": "index.html",
        "width": 240,
        "height": 290,
        "minWidth": 220,
        "minHeight": 260,
        "resizable": true,
        "visible": false,
        "alwaysOnTop": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
